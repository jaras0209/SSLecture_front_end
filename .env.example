# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# 複製此檔案為 .env.development（本地開發）或 .env.production（生產部署）
# 請勿將含有真實金鑰的 .env 檔案提交至 Git
# ─────────────────────────────────────────────────────────────────────────────

# 後端 API 基底 URL（後端就緒後填入實際位址）
# 開發環境範例：VITE_API_BASE_URL=http://localhost:8080
# 生產環境範例：VITE_API_BASE_URL=https://api.sslecture.example.com
VITE_API_BASE_URL=

# Google OAuth 2.0 Client ID（在 Google Cloud Console 建立）
# 格式：XXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# LINE Login Channel ID（在 LINE Developers Console 建立）
VITE_LINE_CHANNEL_ID=
