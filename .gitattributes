# Enforce LF line endings for all source files (prevents CRLF encoding corruption on Windows)
* text=auto eol=lf

# Vue, TypeScript, JavaScript — always LF
*.vue text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# Config files
.editorconfig text eol=lf
vite.config.ts text eol=lf
vitest.config.ts text eol=lf
tsconfig*.json text eol=lf

# Binary — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
