{
  "name": "sslecture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,json,css}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dicebear/adventurer": "^9.4.3",
    "@dicebear/avataaars": "^9.4.3",
    "@dicebear/bottts": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@dicebear/fun-emoji": "^9.4.3",
    "@dicebear/lorelei": "^9.4.3",
    "@dicebear/micah": "^9.4.3",
    "@dicebear/notionists": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.7",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.8"
  }
}
