{
  "name": "sslecture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,json,css}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dicebear/adventurer": "^9.4.3",
    "@dicebear/avataaars": "^9.4.3",
    "@dicebear/bottts": "^9.4.3",
    "@dicebear/core": "^10.7.0",
    "@dicebear/fun-emoji": "^9.4.3",
    "@dicebear/lorelei": "^9.4.3",
    "@dicebear/micah": "^9.4.3",
    "@dicebear/notionists": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.3",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "~5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "~8.72.2",
    "@typescript-eslint/parser": "~8.72.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "~10.12.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
